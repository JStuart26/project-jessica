dashboard() {
    show_banner
    show_greeting
    show_system_info
    check_git
    check_docker
    show_projects
    finish
}

#show_help() {
#    echo
#    echo "PROJECT JESSICA COMMANDS"
#    echo
#    echo "  jessica              Show the project dashboard"
#    echo "  jessica next         Update a project's next step"
#    echo "  jessica note         Add a timestamped project note"
#    echo "  jessica note ID TEXT Add a note without the picker"
#    echo "  jessica done         Complete and archive the next step"
#    echo "  jessica history      Show a project's completed-task history"
#    echo "  jessica projects     Show the project dashboard"
#    echo "  jessica help         Show this command list"
#    echo
#}

case "${1:-}" in
    "")
        dashboard
        ;;

    next)
        update_next_step
        ;;

    projects)
        dashboard
        ;;

    help|--help|-h)
        show_help
        ;;

    note)
        shift
        add_note "$@"
        ;;

    done)
        complete_next_step
        ;;

    history)
        show_history
        ;;

    *)
        echo "❌ Unknown command: $1"
        show_help
        exit 1
        ;;
esac
