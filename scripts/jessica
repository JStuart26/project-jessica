find_project_by_id() {
    SEARCH_ID="$1"

    while IFS="|" read -r NAME PROJECT_PATH TYPE PROJECT_ID
    do
        if [ "$PROJECT_ID" = "$SEARCH_ID" ]; then
            SELECTED_NAME="$NAME"
            SELECTED_ID="$PROJECT_ID"
            return 0
        fi
    done < "$PROJECT_ROOT/data/projects.conf"

    return 1
}

