#!/bin/bash

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"

    if [[ "$SOURCE" != /* ]]; then
        SOURCE="$SOURCE_DIR/$SOURCE"
    fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

source "$PROJECT_ROOT/commands/help.sh"
source "$PROJECT_ROOT/commands/dashboard.sh"
source "$PROJECT_ROOT/commands/next.sh"
source "$PROJECT_ROOT/commands/note.sh"
source "$PROJECT_ROOT/commands/done.sh"
source "$PROJECT_ROOT/commands/history.sh"
source "$PROJECT_ROOT/commands/projects.sh"
source "$PROJECT_ROOT/commands/remember.sh"
source "$PROJECT_ROOT/commands/add.sh"

###############################################################################
# Project Jessica
# Version: 0.3.0
#
# Purpose:
#   Prepare the development workspace and verify that the environment
#   is ready for coding.
#
# Author:
#   Justin Stuart
###############################################################################

case "${1:-}" in
    "")
        dashboard
        ;;

    next)
        update_next_step
        ;;

    projects)
        dashboard
        ;;

    help|--help|-h)
        show_help
        ;;

    note)
        shift
        add_note "$@"
        ;;

    done)
        complete_next_step
        ;;

    history)
        show_history
        ;;

    remember)
	shift
	remember "$@"
	;;

    add)
	shift
        add "$@"
	;;

    *)
        echo "❌ Unknown command: $1"
        show_help
        exit 1
        ;;
esac
